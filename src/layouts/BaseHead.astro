---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";

/**
 * Lo que comparten el estudio (HomeLayout) y las preventas (PreventasLayout):
 * metadatos, SEO y el router de transiciones. Cada layout aporta su propia
 * hoja de estilos, su cabecera y su pie; aquí no entra nada visual.
 */
interface Props {
  title: string;
  description: string;
  /** Imagen social ya resuelta (ruta o URL) o ImageMetadata de Astro para optimizar. */
  image?: ImageMetadata | string;
  keywords?: readonly string[];
}

const SITE_NAME = "Zerho Arquitectura";

const { title, description, image = "/ico.png", keywords } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

let socialImageSrc = "/ico.png";
let imageWidth = 1200;
let imageHeight = 630;
let imageType = "image/png";

if (typeof image === "object" && image !== null && "src" in image) {
  // Optimizar la imagen a JPEG de 1200x630 (tamaño y peso < 300KB para WhatsApp, Facebook, X, etc.)
  const optimized = await getImage({
    src: image,
    width: 1200,
    height: 630,
    format: "jpeg",
    quality: 80,
  });
  socialImageSrc = optimized.src;
  imageWidth = 1200;
  imageHeight = 630;
  imageType = "image/jpeg";
} else if (typeof image === "string") {
  socialImageSrc = image;
  if (image.endsWith(".jpg") || image.endsWith(".jpeg")) {
    imageType = "image/jpeg";
  } else if (image.endsWith(".webp")) {
    imageType = "image/webp";
  } else if (image.endsWith(".png")) {
    imageType = "image/png";
  }
}

const socialImage = new URL(socialImageSrc, Astro.site).href;
---

<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#333a30" />
<link rel="icon" type="image/png" href="/ico.png" />

<SEO
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    basic: { title, type: "website", image: socialImage, url: canonical },
    optional: { description, locale: "es_MX", siteName: SITE_NAME },
    image: {
      url: socialImage,
      secureUrl: socialImage,
      alt: title,
      width: imageWidth,
      height: imageHeight,
      type: imageType,
    },
  }}
  twitter={{
    card: "summary_large_image",
    title,
    description,
    image: socialImage,
    imageAlt: title,
  }}
  extend={{
    meta: keywords?.length
      ? [{ name: "keywords", content: keywords.join(", ") }]
      : [],
  }}
/>

<!--
  Marca el documento como "con JavaScript" antes del primer pintado: los
  `.reveal` se ocultan sin parpadeo y, sin JS, se quedan visibles. El
  ClientRouter reemplaza los atributos de <html> al navegar, así que la clase
  se vuelve a poner tras cada intercambio.
-->
<script is:inline>
  document.documentElement.classList.add("js");
  document.addEventListener("astro:after-swap", () =>
    document.documentElement.classList.add("js"),
  );
</script>

<ClientRouter fallback="swap" />
