---
import "@/styles/global.css";
import { SITE } from "@/data/site";
import BaseHead from "./BaseHead.astro";
import SiteHeader from "@/components/shared/SiteHeader.astro";
import SiteFooter from "@/components/shared/SiteFooter.astro";
import ScrollReveal from "@/components/shared/ScrollReveal.astro";
import ScrollTop from "@/components/shared/ScrollTop.astro";
import StickyVisit from "@/components/shared/StickyVisit.astro";

/** Preventas: las fichas de residencia (y el 404, que las ofrece). */
interface Props {
  title: string;
  description: string;
  /** Imagen social. Se resuelve a URL absoluta para Open Graph. */
  image?: ImageMetadata;
  /** Residencia en pantalla: personaliza contacto y marca el menú. */
  propertyTitle?: string;
  currentId?: string;
  showSections?: boolean;
}

const {
  title,
  description,
  image,
  propertyTitle,
  currentId,
  showSections = true,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <BaseHead title={fullTitle} description={description} image={image?.src} />
  </head>

  <body class="bg-canvas text-ink antialiased">
    <a
      href="#residencia"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]"
    >
      Saltar al contenido
    </a>

    <SiteHeader currentId={currentId} showSections={showSections} />

    <main>
      <slot />
    </main>

    <SiteFooter propertyTitle={propertyTitle} currentId={currentId} />

    {showSections && <StickyVisit propertyTitle={propertyTitle} />}
    <ScrollTop />
    <ScrollReveal />
  </body>
</html>
