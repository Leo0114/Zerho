---
import { Image } from "astro:assets";
import firstLogo from "@/assets/firstLogo.png";
import { homeData } from "@/data/home";
import { SOCIAL_LINKS } from "@/data/site";
import {
  CONTACT_PATH,
  HOME_SECTIONS,
  SITE_PAGES,
  sectionHref,
} from "@/lib/navigation";
import { SOCIAL_ICONS } from "./socialIcons";

const { hero } = homeData;
const { pathname } = Astro.url;
const year = new Date().getFullYear();
---

<footer data-surface="dark" class="bg-secondary text-darkGray">
  <div class="mx-auto w-full max-w-7xl px-5 pb-10 pt-20 sm:px-8 lg:px-12 lg:pt-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="footer-brand" aria-label="Zerho Arquitectura — inicio">
          <Image src={firstLogo} alt="" width={640} height={640} widths={[320, 640]} sizes="12rem" />
        </a>
        <p class="mt-6 max-w-sm text-[0.9375rem] leading-relaxed text-darkGray/60">
          {hero.preTitle}. {hero.specialties.join(" · ")}.
        </p>

        <ul class="mt-8 flex items-center gap-5 text-darkGray/60">
          {
            SOCIAL_LINKS.map(({ id, label, href }) => {
              const Icon = SOCIAL_ICONS[id];
              return (
                <li>
                  <a href={href} class="hover:text-darkGray transition-colors" aria-label={label} target="_blank" rel="noopener noreferrer">
                    <Icon className="h-5 w-5" />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <nav aria-label="Pie de página" class="lg:col-span-3">
        <p class="footer-heading">Explorar</p>
        <ul class="mt-5 grid gap-3">
          {
            HOME_SECTIONS.map((item) => (
              <li>
                <a href={sectionHref(item.id, pathname)} class="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
          {
            SITE_PAGES.map((page) => (
              <li><a href={page.path} class="footer-link">{page.label}</a></li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <p class="footer-heading">Déjanos tus datos</p>
        <p class="mt-4 max-w-xs text-[0.9375rem] text-darkGray/60 text-pretty">
          Ingresa tu correo y nos pondremos en contacto contigo a la brevedad para hablar de tu proyecto.
        </p>
        <form id="footer-contact-form" class="mt-5 flex flex-col gap-3 relative" action={CONTACT_PATH} method="GET">
          <input 
            type="email" 
            name="email"
            id="footer-email-input"
            placeholder="Tu correo electrónico" 
            class="w-full rounded-full border border-darkGray/20 bg-darkGray/5 px-5 py-3 text-sm text-darkGray placeholder-darkGray/40 outline-none transition-colors focus:border-darkGray/60 focus:bg-darkGray/10" 
            required 
          />
          <button 
            type="submit" 
            id="footer-submit-btn"
            class="w-full rounded-full bg-white px-5 py-3 text-sm font-semibold text-black shadow-md transition-transform hover:scale-[1.02] active:scale-[0.98] cursor-pointer disabled:opacity-70 disabled:hover:scale-100"
          >
            Contactar
          </button>
          <p id="footer-msg" class="hidden text-xs text-darkGray/80 mt-1 font-medium text-center"></p>
        </form>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-darkGray/12 pt-8 text-xs text-darkGray/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Zerho Arquitectura. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <p>Cero sorpresas, por contrato.</p>
        <span class="hidden sm:inline opacity-30" aria-hidden="true">•</span>
        <p>
          Made by{" "}
          <a
            href="https://optimmkt.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-darkGray/70 underline underline-offset-4 transition-colors hover:text-darkGray focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-darkGray/50 focus-visible:ring-offset-2"
          >
            Optim
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-brand {
    display: block;
    width: 11rem;
    aspect-ratio: 3 / 1;
    overflow: clip;
    transition: opacity 150ms ease-out;
  }

  .footer-brand:active {
    opacity: 0.7;
  }

  .footer-brand :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-warmGray);
  }

  .footer-link {
    font-size: 0.9375rem;
    color: rgb(233 225 209 / 0.65);
    transition: color 300ms var(--ease-out-expo);
  }

  .footer-link:hover {
    color: var(--color-darkGray);
  }
</style>

<script>
  function setupFooterForm() {
    const form = document.getElementById("footer-contact-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", async (e) => {
      const emailInput = document.getElementById("footer-email-input") as HTMLInputElement | null;
      const btn = document.getElementById("footer-submit-btn") as HTMLButtonElement | null;
      const msg = document.getElementById("footer-msg");
      if (!emailInput || !btn) return;

      const email = emailInput.value.trim();
      if (!email) return;

      e.preventDefault();
      btn.disabled = true;
      btn.textContent = "Enviando…";

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        if (res.ok) {
          btn.textContent = "✓ Recibido";
          btn.classList.add("!bg-[#333a30]", "!text-white");
          emailInput.value = "";
          if (msg) {
            msg.textContent = "¡Gracias! Te contactaremos a la brevedad.";
            msg.classList.remove("hidden");
          }
        } else {
          window.location.href = `/contact?email=${encodeURIComponent(email)}`;
        }
      } catch {
        window.location.href = `/contact?email=${encodeURIComponent(email)}`;
      } finally {
        setTimeout(() => {
          btn.disabled = false;
        }, 4000);
      }
    });
  }

  setupFooterForm();
  document.addEventListener("astro:page-load", setupFooterForm);
</script>
