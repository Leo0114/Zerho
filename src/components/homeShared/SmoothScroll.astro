---
/**
 * Scroll con inercia (Lenis). Con `prefers-reduced-motion` no se monta y el
 * navegador hace su scroll nativo; las anclas usan `scroll-padding-top`.
 *
 * El script sobrevive a las navegaciones del ClientRouter, así que comprueba
 * el marcador en cada página: las preventas no lo montan y conservan su
 * scroll nativo (del que dependen sus modales).
 */
---

<span data-smooth-scroll hidden></span>

<script>
  import Lenis from "lenis";
  import "lenis/dist/lenis.css";

  let lenis: Lenis | null = null;

  const headerOffset = () =>
    -(document.getElementById("site-header")?.offsetHeight ?? 80) - 16;

  /**
   * Anclas de la misma página: se interceptan en captura, antes que el
   * ClientRouter (que respeta `defaultPrevented`), para que sea Lenis quien
   * desplace con su curva y no un salto instantáneo.
   */
  function onAnchorClick(event: MouseEvent) {
    if (!lenis || event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = (event.target as Element | null)?.closest("a[href*='#']");
    if (!(link instanceof HTMLAnchorElement)) return;

    const url = new URL(link.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname) return;

    const target = url.hash.length > 1 ? document.querySelector(decodeURIComponent(url.hash)) : null;
    if (!target) return;

    event.preventDefault();
    lenis.scrollTo(target as HTMLElement, { offset: headerOffset() });
  }

  function start() {
    lenis?.destroy();
    lenis = null;

    if (!document.querySelector("[data-smooth-scroll]")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    lenis = new Lenis({ autoRaf: true, lerp: 0.09, wheelMultiplier: 0.9 });
  }

  document.addEventListener("astro:page-load", start);
  document.addEventListener("astro:before-swap", () => {
    lenis?.destroy();
    lenis = null;
  });
  window.addEventListener("click", onAnchorClick, { capture: true });
</script>
