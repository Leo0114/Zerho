---
import { render } from "astro:content";

import {
  COMMITMENTS,
  INTERIORS,
  PROMISE,
  WARRANTY,
  whatsappHref,
} from "@/data/site";
import {
  formatPrice,
  getLead,
  getOtherProperties,
  type Property,
} from "@/lib/properties";
import { pickRandomGalleryImage } from "@/lib/gallery";

import PropertyHero from "@/components/shared/PropertyHero.astro";
import SectionHeader from "@/components/shared/SectionHeader.astro";
import SpecSheet from "@/components/shared/SpecSheet.astro";
import SplitFeature from "@/components/shared/SplitFeature.astro";
import Gallery from "@/components/shared/Gallery.astro";
import PlansViewer from "@/components/shared/PlansViewer.astro";
import PillarGrid from "@/components/shared/PillarGrid.astro";
import Statement from "@/components/shared/Statement.astro";
import PropertyCard from "@/components/shared/PropertyCard.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import Button from "@/components/ui/Button.astro";
import Modal from "@/components/ui/Modal.astro";
import ModalTrigger from "@/components/ui/ModalTrigger.astro";
import PropertyDetailModal from "@/components/shared/PropertyDetailModal.astro";

/**
 * Ficha completa de una residencia.
 *
 * Es el único montaje de página del sitio: la portada y `/[slug]` se limitan a
 * elegir qué propiedad le pasan. Así las fichas no pueden divergir —ni en
 * orden de secciones, ni en anclas, ni en ritmo—.
 *
 * El orden sigue la decisión del comprador: qué casa es y dónde está, quién la
 * respalda, cómo se ve, cómo se distribuye y, al final, el detalle técnico
 * para comparar. La página enseña lo esencial; el texto largo se abre bajo
 * demanda en modales, nunca se impone.
 */
interface Props {
  property: Property;
}

const { property } = Astro.props;
const { data } = property;

const { Content } = await render(property);
const { heading, lead } = getLead(property);
const others = await getOtherProperties(property);

const featureImage = pickRandomGalleryImage(
  data.galleryDir,
  data.cover,
  data.cover,
);

/** Ids de modal únicos por ficha: evita choques entre navegaciones. */
const modalId = (name: string) => `${property.id}-${name}`;
const MODALS = {
  story: modalId("historia"),
  commitment: modalId("compromiso"),
  interiors: modalId("interiorismo"),
  specs: modalId("ficha"),
} as const;
---

<PropertyHero
  title={data.title}
  location={data.location}
  status={data.status}
  price={data.price}
  currency={data.currency}
  excerpt={data.excerpt}
  cover={data.cover}
  coverAlt={data.coverAlt}
  highlights={data.highlights}
/>

{
  /* --- Residencia: lo esencial para decidir una visita ----------------------- */
}
<section class="section-y">
  <div class="container-x grid gap-12 lg:grid-cols-[17rem_1fr] lg:gap-20">
    <div
      class="reveal lg:sticky lg:top-[calc(var(--chrome-h)+3rem)] lg:self-start"
    >
      <p class="type-eyebrow flex items-center gap-3 text-accent-deep">
        <span class="h-px w-8 bg-accent/45" aria-hidden="true"></span>
        La residencia
      </p>

      <dl class="mt-8 grid grid-cols-2 gap-6 lg:grid-cols-1">
        <div class="col-span-2 lg:col-span-1">
          <dt class="type-eyebrow text-muted">Ubicación exclusiva</dt>
          <dd class="mt-2 text-[0.95rem] leading-snug text-ink">
            {data.location}
          </dd>
        </div>
        <div>
          <dt class="type-eyebrow text-muted">Etapa</dt>
          <dd class="mt-2 text-[0.95rem] leading-snug text-ink">
            {data.status}
          </dd>
        </div>
        <div>
          <dt class="type-eyebrow text-muted">Precio</dt>
          <dd class="type-stat mt-2.5 text-ink">
            {formatPrice(data.price, data.currency)}
          </dd>
        </div>
      </dl>
    </div>

    <div>
      <div class="reveal max-w-2xl">
        {heading && <h2 class="type-title text-ink">{heading}</h2>}
        {lead && <p class="type-body mt-5 text-muted">{lead}</p>}
        <ModalTrigger target={MODALS.story} class="mt-7">
          Conocer la residencia
        </ModalTrigger>
      </div>
    </div>
  </div>

  <PropertyDetailModal
    id={MODALS.story}
    property={property}
    Content={Content}
  />
</section>

{
  /* --- Compromiso ------------------------------------------------------------ */
}
<section
  id="compromiso"
  class="section-anchor section-y bg-primary text-on-primary"
>
  <div class="container-x">
    <SectionHeader
      tone="dark"
      eyebrow={PROMISE.eyebrow}
      title={PROMISE.title}
      description={PROMISE.lead}
    />

    <PillarGrid
      items={COMMITMENTS}
      tone="dark"
      variant="bare"
      columns={5}
      compact
      class="mt-12"
    />

    <div class="reveal mt-10">
      <ModalTrigger target={MODALS.commitment} variant="glass">
        Cómo trabajamos
      </ModalTrigger>
    </div>

    <Statement
      class="mt-14"
      figure={WARRANTY.years}
      figureUnit="años"
      title={WARRANTY.title}
      body={WARRANTY.body}
    />
  </div>

  <Modal
    id={MODALS.commitment}
    eyebrow={PROMISE.eyebrow}
    title="Cómo trabajamos"
    size="lg"
  >
    <p class="type-body text-muted">{PROMISE.body}</p>
    <ol class="mt-8 grid gap-x-10 gap-y-7 md:grid-cols-2">
      {
        COMMITMENTS.map((item, i) => (
          <li>
            <span class="type-label tabular-nums text-accent-deep">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-2 text-[1.05rem] font-semibold leading-snug tracking-[-0.01em] text-ink">
              {item.title}
            </h3>
            <p class="mt-1.5 text-[0.93rem] leading-relaxed text-muted">
              {item.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Modal>
</section>

{
  /* --- Galería --------------------------------------------------------------- */
}
<section id="galeria" class="section-anchor section-y">
  <div class="container-x">
    <SectionHeader
      eyebrow="Galería"
      title="Recorrido visual"
      description="Toca cualquier imagen para recorrerla a pantalla completa."
    />

    <Gallery
      dir={data.galleryDir}
      subject={data.title}
      layout="mosaic"
      class="mt-12"
    />

    {/* Interiorismo: una invitación discreta, no un anuncio */}
    <div
      class="reveal mt-10 flex flex-col items-start gap-4 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-xl text-[0.95rem] leading-relaxed text-muted">
        <span class="font-semibold text-ink">¿Te gusta cómo se ve?</span>
        Los interiores de estas imágenes también son obra nuestra.
      </p>
      <ModalTrigger target={MODALS.interiors}>
        {INTERIORS.eyebrow}
      </ModalTrigger>
    </div>
  </div>

  <Modal
    id={MODALS.interiors}
    eyebrow={INTERIORS.eyebrow}
    title={INTERIORS.title}
  >
    <p class="type-subheading text-ink">{INTERIORS.lead}</p>
    {
      INTERIORS.body.map((paragraph) => (
        <p class="type-body mt-4 text-muted">{paragraph}</p>
      ))
    }
    <Fragment slot="footer">
      <Button
        href={whatsappHref(data.title, "interiores")}
        external
        variant="primary"
        size="sm"
        icon="arrow-right"
      >
        {INTERIORS.cta}
      </Button>
    </Fragment>
  </Modal>
</section>

{
  /* --- Planos ---------------------------------------------------------------- */
}
{
  data.plans.length > 0 && (
    <section
      id="planos"
      class="section-anchor section-y hairline-t bg-panel/60"
    >
      <div class="container-x">
        <SectionHeader
          eyebrow="Planos"
          title="Distribución por nivel"
          description="Amplía una lámina para recorrer todas las plantas."
        />

        <PlansViewer plans={data.plans} subject={data.title} class="mt-10" />
      </div>
    </section>
  )
}

{
  /* --- Características: el detalle para comparar ----------------------------- */
}
<!-- <section
  id="caracteristicas"
  class:list={[
    "section-anchor section-y",
    data.plans.length === 0 && "hairline-t",
  ]}
>
  <div class="container-x">
    <SplitFeature
      eyebrow="Especificación constructiva"
      title="Lo que se firma es lo que se construye"
      body={[
        "Cada partida queda definida por marca, sistema y espesor desde el proyecto ejecutivo. Por eso podemos firmar a precio alzado.",
      ]}
      image={featureImage}
      imageAlt={`Interior de ${data.title}`}
      imageSide="right"
    >
      <ModalTrigger target={MODALS.story} class="mt-8">
        Ver ficha completa
      </ModalTrigger>
    </SplitFeature>

    <SpecSheet items={data.specs} compact class="mt-16" />
  </div>
</section> -->

{
  /* --- Visita ---------------------------------------------------------------- */
}
<CtaSection
  propertyTitle={data.title}
  title={`Recorre ${data.title} en persona`}
  description="Te acompañamos a conocerla y, en una sola conversación, resolvemos juntos el proyecto, los tiempos y el esquema de aportaciones."
/>

{
  /* --- Otras oportunidades --------------------------------------------------- */
}
{
  others.length > 0 && (
    <section id="otras" class="section-anchor section-y hairline-t bg-panel/60">
      <div class="container-x">
        <SectionHeader
          eyebrow="Otras oportunidades"
          title="Más residencias en San Pedro"
          description="El mismo estándar constructivo y el mismo compromiso."
        />

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:gap-8">
          {others.map((other, i) => (
            <div class="reveal" style={`transition-delay:${i * 60}ms`}>
              <PropertyCard property={other} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
