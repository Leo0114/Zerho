---
import { LuCheck } from "react-icons/lu";
import Container from "@/components/homeShared/ui/Container.astro";
import Eyebrow from "@/components/homeShared/ui/Eyebrow.astro";
import type { HomeData } from "@/data/home";
import { splitLabel } from "@/lib/format";

/** La cifra es lo único grande: si todo destaca, nada destaca. */
interface Props {
  warranty: HomeData["warrantyAndValue"];
}

const { warranty } = Astro.props;
---

<section
  id="garantia"
  data-surface="dark"
  class="warranty relative isolate overflow-clip bg-primary py-28 text-white sm:py-36 lg:py-44"
>
  <div class="glow glow--a" aria-hidden="true"></div>
  <div class="glow glow--b" aria-hidden="true"></div>

  <Container class="grid gap-16 lg:grid-cols-12 lg:items-center lg:gap-20">
    <div class="reveal lg:col-span-5">
      <p class="flex items-end gap-4">
        <span class="figure">{warranty.years}</span>
        <span class="pb-4 text-[0.6875rem] font-semibold uppercase leading-tight tracking-[0.22em] text-darkGray/80">
          años de<br />garantía
        </span>
      </p>
    </div>

    <div class="lg:col-span-7">
      <div class="reveal">
        <Eyebrow tone="dark">Garantía y plusvalía</Eyebrow>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.6vw,3.75rem)] font-medium leading-[1.04] tracking-[-0.015em] text-balance">
          {warranty.title}
        </h2>
        <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-darkGray/75 text-pretty">
          {warranty.description}
        </p>
      </div>

      <ul class="mt-12 grid gap-3">
        {
          warranty.benefits.map((benefit, i) => {
            const { label, body } = splitLabel(benefit);
            return (
              <li class="reveal benefit" style={`--reveal-delay: ${i * 70}ms`}>
                <span class="benefit-icon" aria-hidden="true">
                  <LuCheck />
                </span>
                <p class="text-[0.9375rem] leading-relaxed text-darkGray/75 text-pretty">
                  {label ? (
                    <>
                      <strong class="font-semibold text-white">{label}.</strong> {body}
                    </>
                  ) : (
                    <strong class="font-semibold text-white">{body}</strong>
                  )}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  /* Luz cálida tras el cristal: sin algo que difuminar, el cristal no se ve. */
  .glow {
    position: absolute;
    z-index: -1;
    border-radius: 9999px;
    filter: blur(80px);
    pointer-events: none;
  }

  .glow--a {
    top: -10rem;
    right: -8rem;
    width: 32rem;
    height: 32rem;
    background: rgb(147 119 74 / 0.45);
  }

  .glow--b {
    bottom: -12rem;
    left: -10rem;
    width: 28rem;
    height: 28rem;
    background: rgb(194 182 170 / 0.18);
  }

  .figure {
    font-family: var(--font-display);
    font-size: clamp(9rem, 22vw, 17rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #fff 10%, var(--color-coolGray) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .benefit {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.15rem 1.25rem;
    border-radius: 1.25rem;
    background: var(--glass-dark-bg);
    border: 1px solid var(--glass-dark-border);
    box-shadow: inset 0 1px 0 var(--glass-dark-highlight);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  }

  .benefit-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: -0.05rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    color: var(--color-primary);
    background: var(--color-darkGray);
  }
</style>
