---
import Container from "@/components/homeShared/ui/Container.astro";
import SectionHeading from "@/components/homeShared/ui/SectionHeading.astro";
import TrayectoriaSliderComponent from "./TrayectoriaSlider";
import RenderVsRealidad from "./RenderVsRealidad";
---

<section
  id="trayectoria"
  class="py-24 sm:py-28 lg:py-36 relative overflow-hidden bg-warmGray/5"
>
  <div
    class="absolute inset-0 bg-linear-to-t from-transparent to-ink/2 pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <Container>
    <SectionHeading
      eyebrow="Nuestra Trayectoria"
      title="Un legado construido"
      align="center"
      description="A lo largo de los años, hemos transformado visiones en realidades impactantes. Nuestro portafolio es un testimonio vivo de la dedicación, la precisión técnica y la excelencia que aplicamos en cada obra, superando siempre las expectativas iniciales."
      class="mb-4"
    />

    <!-- <TrayectoriaSliderComponent client:visible /> -->

    <RenderVsRealidad client:visible />
  </Container>
</section>
