---
import { Image } from "astro:assets";
import Container from "@/components/homeShared/ui/Container.astro";
import SectionHeading from "@/components/homeShared/ui/SectionHeading.astro";
import type { ServiceDetail } from "@/data/home";
import { splitIndexedTitle, splitLabel } from "@/lib/format";
import { IMAGE_ALT } from "@/lib/images";

import img1 from "@/assets/homeAssets/images/encinos11.png";
import img2 from "@/assets/homeAssets/images/balcones.png";
import img3 from "@/assets/homeAssets/images/inter.png";
import img4 from "@/assets/homeAssets/images/FPENC8_01.jpg";

const serviceImages = [img1, img2, img3, img4];

interface Props {
  services: readonly ServiceDetail[];
}

const { services } = Astro.props;
---

<section id="servicios" class="py-28 sm:py-36 lg:py-44">
  <Container>
    <SectionHeading
      eyebrow="Nuestra razón de ser"
      title="Los caminos hacia tu residencia"
    />

    <div class="mt-20 flex flex-col gap-24 sm:mt-24 lg:gap-36">
      {
        services.map((service, i) => {
          const { index, label } = splitIndexedTitle(service.title);
          const reversed = i % 2 === 1;
          const image = serviceImages[i] ?? serviceImages[0];

          return (
            <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
              <figure
                class:list={[
                  "reveal service-media relative overflow-clip rounded-[2rem] lg:col-span-6",
                  reversed && "lg:order-2",
                ]}
              >
                <Image
                  src={image}
                  alt={IMAGE_ALT}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1024px) 45vw, 100vw"
                  class="service-image aspect-[4/5] h-full w-full object-cover sm:aspect-[4/3] lg:aspect-[4/5]"
                />
                <span class="service-badge" aria-hidden="true">{index}</span>
              </figure>

              <div class:list={["lg:col-span-6", reversed ? "lg:pr-8" : "lg:pl-8"]}>
                <div class="reveal">
                  <p class="text-xs font-semibold tabular-nums tracking-[0.18em] text-warmGray">
                    {index}
                  </p>
                  <h3 class="mt-4 font-display text-[clamp(2rem,3.4vw,2.875rem)] font-medium leading-[1.06] tracking-[-0.014em] text-balance">
                    {label}
                  </h3>
                  <p class="mt-5 max-w-xl text-[1.0625rem] leading-relaxed text-muted text-pretty">
                    {service.description}
                  </p>
                </div>

                <ul class="mt-10 border-t border-ink/12">
                  {service.features.map((feature, j) => {
                    const { label: featureLabel, body } = splitLabel(feature);
                    return (
                      <li
                        class="reveal border-b border-ink/12 py-5"
                        style={`--reveal-delay: ${j * 60}ms`}
                      >
                        {featureLabel && (
                          <p class="text-[0.9375rem] font-semibold leading-snug text-ink">
                            {featureLabel}
                          </p>
                        )}
                        <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted text-pretty">
                          {body}
                        </p>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  .service-media {
    box-shadow: 0 30px 80px -40px rgb(43 42 38 / 0.5);
  }

  /* Cifra sobre cristal claro, anclada a la esquina de la fotografía. */
  .service-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--glass-light-bg);
    border: 1px solid var(--glass-light-border);
    box-shadow:
      inset 0 1px 0 var(--glass-light-highlight),
      var(--glass-shadow);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  }

  /* La fotografía se asienta mientras entra en pantalla. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .service-media :global(.service-image) {
        animation: image-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }

      @keyframes image-settle {
        from {
          transform: scale(1.12);
        }
        to {
          transform: scale(1);
        }
      }
    }
  }
</style>
