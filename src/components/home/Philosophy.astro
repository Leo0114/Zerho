---
import Container from "@/components/homeShared/ui/Container.astro";
import Eyebrow from "@/components/homeShared/ui/Eyebrow.astro";

/**
 * Propuesta de valor como lectura. Las palabras se encienden al pasar por
 * la pantalla (scroll-driven, sin JS); sin soporte o con movimiento
 * reducido, el texto aparece entero en tinta.
 */
interface Props {
  statement: string;
  specialties?: readonly string[];
}

const { statement, specialties } = Astro.props;
const words = statement.split(/\s+/);
---

<section id="filosofia" class="py-28 sm:py-36 lg:py-44">
  <Container class="flex flex-col items-center justify-center">
    <div class="reveal mb-8">
      <Eyebrow>Nuestra filosofía</Eyebrow>
    </div>

    <div class="w-full flex flex-col items-center">
      <p
        class="statement italic font-display text-[clamp(1.125rem,2.2vw,1.5rem)] font-medium leading-[1.6] text-ink text-center max-w-4xl mx-auto"
      >
        "{words.map((word) => <span class="word">{word} </span>)}"
      </p>

      <ol class="mt-16 grid w-full gap-6 sm:grid-cols-3 sm:gap-12 lg:mt-24">
        {
          specialties?.map((specialty, i) => (
            <li
              class="reveal flex flex-col items-center text-center gap-3 border-t sm:border-t-0 sm:border-l border-ink/12 pt-6 sm:pt-0 sm:pl-8"
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="text-xs font-semibold tabular-nums tracking-[0.14em] text-warmGray">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="font-display text-xl md:text-2xl font-medium leading-tight tracking-[-0.01em]">
                {specialty}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .word {
        animation: word-light linear both;
        animation-timeline: view();
        animation-range: entry 100% cover 45%;
      }

      @keyframes word-light {
        from {
          opacity: 0.18;
        }
        to {
          opacity: 1;
        }
      }
    }
  }
</style>
