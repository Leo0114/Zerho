---
import { Image } from "astro:assets";
import { LuArrowRight, LuPhone } from "react-icons/lu";
import { Button } from "@/components/homeShared/ui/Button";
import Container from "@/components/homeShared/ui/Container.astro";
import Eyebrow from "@/components/homeShared/ui/Eyebrow.astro";
import type { ContactInfo } from "@/data/home";
import { phoneHref } from "@/lib/format";
import { IMAGE_ALT, images } from "@/lib/images";
import { CONTACT_PATH } from "@/lib/navigation";

/** Cierre de la portada: una invitación con nombre y apellido, no un trámite. */
interface Props {
  contact: ContactInfo;
}

const { contact } = Astro.props;
---

<section
  id="contacto"
  data-surface="dark"
  class="relative isolate overflow-clip py-24 text-white sm:py-32"
>
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    <Image
      src={images.contactCta}
      alt={IMAGE_ALT}
      widths={[640, 1280, 1920]}
      sizes="100vw"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-secondary/45" aria-hidden="true"></div>

  <Container>
    <div class="reveal panel mx-auto max-w-3xl text-center">
      <Eyebrow tone="dark" align="center">Contacto</Eyebrow>

      <h2
        class="mt-6 font-display text-[clamp(2.25rem,4.6vw,3.5rem)] font-medium leading-[1.04] tracking-[-0.015em] text-balance"
      >
        {contact.sectionTitle}
      </h2>

      <p
        class="mx-auto mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-white/85 text-pretty"
      >
        {contact.closingMessage}
      </p>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <Button
          href={CONTACT_PATH}
          variant="light"
          size="lg"
          icon={LuArrowRight}
          iconPosition="end"
        >
          Iniciar mi proyecto
        </Button>
        <Button
          href={phoneHref(contact.phone)}
          variant="glass"
          size="lg"
          icon={LuPhone}
        >
          {contact.phone}
        </Button>
      </div>

      <p class="mt-8 text-sm text-white/75">
        Te atiende la <span class="font-semibold text-white"
          >{contact.contactPerson}</span
        >
      </p>
    </div>
  </Container>
</section>

<style>
  /* Superficie grande = material grueso: más desenfoque y sombra profunda. */
  .panel {
    position: relative;
    isolation: isolate;
    padding: 3rem 1.5rem;
    border-radius: 2.25rem;
    background: rgb(43 42 38 / 0.28);
    border: 1px solid var(--glass-dark-border);
    box-shadow:
      inset 0 1px 0 var(--glass-dark-highlight),
      0 40px 100px -30px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(36px) saturate(170%);
    -webkit-backdrop-filter: blur(36px) saturate(170%);
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(
      170deg,
      rgb(255 255 255 / 0.14),
      rgb(255 255 255 / 0) 40%
    );
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .panel {
      padding: 4.5rem 4rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .panel {
      background: rgb(43 42 38 / 0.94);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
