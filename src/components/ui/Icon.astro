---
/**
 * Set de iconos en SVG inline.
 *
 * Se prefiere a `react-icons` porque estas fichas son estáticas: un SVG en el
 * HTML no arrastra runtime de React ni un bundle de iconos al cliente.
 * Todos comparten caja de 24, grosor y terminaciones, así que la familia se
 * lee homogénea aunque los trazos vengan de sitios distintos.
 */
import { ICON_PATHS, type IconName } from "./icons";

export type { IconName };

interface Props {
  name: IconName;
  class?: string;
  /** Grosor del trazo. Se afina en tamaños grandes, se engorda en pequeños. */
  strokeWidth?: number;
}

const { name, class: className = "h-5 w-5", strokeWidth = 1.6 } = Astro.props;

const isFilled = name === "whatsapp";
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
