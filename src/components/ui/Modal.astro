---
import Icon from "./Icon.astro";

/**
 * Modal reutilizable para el detalle bajo demanda.
 *
 * La ficha enseña lo esencial y deja el resto a un toque: el texto largo vive
 * aquí dentro, no en la página. Se abre desde cualquier elemento con
 * `data-modal-open="<id>"` (ver `ModalTrigger.astro`), sin cablear nada más.
 *
 * Se apoya en `<dialog>` nativo: foco atrapado, `Esc`, fondo inerte y capa
 * superior sin librerías. En móvil es una hoja que sube desde el borde
 * inferior —donde está el pulgar—; en pantallas anchas, un panel que se
 * materializa desde el botón que lo abrió.
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  /** `lg` para contenido tabular o en columnas. */
  size?: "md" | "lg";
}

const { id, title, eyebrow, size = "md" } = Astro.props;
const titleId = `${id}-title`;
---

<dialog
  id={id}
  data-modal
  aria-labelledby={titleId}
  class:list={["modal", size === "lg" && "modal-lg"]}
>
  <div class="modal-panel">
    <header class="flex items-start justify-between gap-6 px-6 pt-6 sm:px-9 sm:pt-9">
      <div>
        {
          eyebrow && (
            <p class="type-eyebrow flex items-center gap-3 text-accent-deep">
              <span class="h-px w-6 bg-accent/45" aria-hidden="true" />
              {eyebrow}
            </p>
          )
        }
        <h2
          id={titleId}
          class:list={["modal-title text-ink", eyebrow && "mt-4"]}
        >
          {title}
        </h2>
      </div>

      <button
        type="button"
        data-modal-close
        aria-label="Cerrar"
        class="grid h-10 w-10 shrink-0 cursor-pointer place-items-center rounded-full bg-canvas text-ink transition-[background-color,transform] duration-200 ease-[var(--ease-out-expo)] hover:bg-panel-alt active:scale-90"
      >
        <Icon name="x" class="h-4 w-4" strokeWidth={2} />
      </button>
    </header>

    <div class="modal-body px-6 pb-8 pt-6 sm:px-9 sm:pb-9">
      <slot />
    </div>

    {
      Astro.slots.has("footer") && (
        <footer class="flex flex-wrap items-center gap-3 border-t border-line px-6 py-5 sm:px-9">
          <slot name="footer" />
        </footer>
      )
    }
  </div>
</dialog>

<style>
  /* --- Caja: el <dialog> sólo posiciona; la piel es del panel ------------ */
  .modal {
    width: 100%;
    max-width: 100vw;
    max-height: 100svh;
    margin: auto 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: visible;
  }

  .modal-panel {
    display: flex;
    flex-direction: column;
    max-height: 88svh;
    border-radius: 1.75rem 1.75rem 0 0;
    background-color: var(--color-panel);
    box-shadow: var(--shadow-e3);
    padding-bottom: env(safe-area-inset-bottom);

    /* Hoja: entra y sale por el mismo borde. */
    transform: translate3d(0, 100%, 0);
    transition: transform 460ms var(--ease-out-quint);
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.6vw, 2.1rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .modal-body {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .modal[data-state="open"] .modal-panel {
    transform: none;
  }

  /* --- Velo: atenúa para enfocar, sin apagar del todo la ficha ----------- */
  .modal::backdrop {
    background-color: rgb(27 31 25 / 0);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition:
      background-color 460ms var(--ease-out-quint),
      backdrop-filter 460ms var(--ease-out-quint);
  }

  .modal[data-state="open"]::backdrop {
    background-color: rgb(27 31 25 / 0.46);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* --- Panel centrado en pantallas anchas --------------------------------
     Se materializa: escala, opacidad y desenfoque a la vez, anclado al
     disparador (el JS fija `transform-origin`).                           */
  @media (min-width: 640px) {
    .modal {
      width: min(40rem, calc(100vw - 4rem));
      margin: auto;
    }

    .modal-lg {
      width: min(58rem, calc(100vw - 4rem));
    }

    .modal-panel {
      max-height: min(86svh, 50rem);
      border-radius: var(--radius-frame);
      padding-bottom: 0;
      opacity: 0;
      filter: blur(6px);
      transform: scale(0.96);
      transition:
        transform 420ms var(--ease-out-quint),
        opacity 320ms var(--ease-out-quint),
        filter 320ms var(--ease-out-quint);
    }

    .modal[data-state="open"] .modal-panel {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* --- Accesibilidad -------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .modal-panel,
    .modal[data-state="open"] .modal-panel {
      transform: none;
      filter: none;
    }

    .modal-panel {
      opacity: 0;
      transition: opacity 160ms linear !important;
    }

    .modal[data-state="open"] .modal-panel {
      opacity: 1;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .modal[data-state="open"]::backdrop {
      background-color: rgb(27 31 25 / 0.75);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

<script>
  import "@/scripts/modal";
</script>
