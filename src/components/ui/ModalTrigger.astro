---
import Icon from "./Icon.astro";

/**
 * Botón que abre un `Modal` por su `id`. Existe para que todos los "ver más"
 * de la ficha se vean y se comporten igual: siempre como botón, nunca como
 * un enlace que se confunde con el texto.
 *  · `quiet` — sobre fondo claro (filete bronce)
 *  · `glass` — sobre verde o fotografía
 */
interface Props {
  target: string;
  variant?: "quiet" | "glass";
  class?: string;
}

const { target, variant = "quiet", class: className = "" } = Astro.props;

const VARIANT_CLASS = {
  quiet: "btn-quiet",
  glass: "btn-glass",
} as const;
---

<button
  type="button"
  data-modal-open={target}
  aria-haspopup="dialog"
  aria-controls={target}
  class:list={["btn btn-sm group", VARIANT_CLASS[variant], className]}
>
  <slot />
  <Icon
    name="plus"
    class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:rotate-90"
    strokeWidth={2}
  />
</button>
