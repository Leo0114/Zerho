---
import Icon from "./Icon.astro";

/**
 * Botón que abre un `Modal` por su `id`. Existe para que todos los "ver más"
 * de la ficha se vean y se comporten igual.
 *  · `outline` — botón sobre fondo claro
 *  · `glass`   — botón sobre verde o fotografía
 *  · `link`    — enlace discreto dentro de un bloque de texto
 */
interface Props {
  target: string;
  variant?: "outline" | "glass" | "link";
  class?: string;
}

const { target, variant = "outline", class: className = "" } = Astro.props;

const VARIANT_CLASS = {
  outline: "btn btn-outline btn-sm",
  glass: "btn btn-glass btn-sm",
  link: "inline-flex cursor-pointer items-center gap-2 text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-accent-deep underline-offset-[6px] transition-colors duration-300 hover:text-ink hover:underline",
} as const;
---

<button
  type="button"
  data-modal-open={target}
  aria-haspopup="dialog"
  aria-controls={target}
  class:list={["group", VARIANT_CLASS[variant], className]}
>
  <slot />
  <Icon
    name="plus"
    class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:rotate-90"
    strokeWidth={2}
  />
</button>
