---
import Icon from "@/components/ui/Icon.astro";
import { whatsappHref } from "@/data/site";

/**
 * Acción fija en móvil: agendar la visita.
 *
 * Sustituye a la barra de secciones, que en pantallas estrechas obligaba a
 * deslizar un índice diminuto. Aquí hay una sola decisión al alcance del
 * pulgar. Sólo aparece cuando hace falta: no sobre el hero (que ya tiene su
 * propio botón) ni cuando el bloque de visita está en pantalla.
 */
interface Props {
  propertyTitle?: string;
}

const { propertyTitle } = Astro.props;
---

<div
  data-sticky-visit
  class="sticky-visit pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-4 pb-[max(0.9rem,env(safe-area-inset-bottom))] lg:hidden"
>
  <a
    href={whatsappHref(propertyTitle)}
    target="_blank"
    rel="noopener noreferrer"
    tabindex="-1"
    class="material-chrome press-soft pointer-events-auto inline-flex items-center gap-2.5 rounded-full border border-line/70 py-3 pl-4 pr-5 text-[0.72rem] font-semibold uppercase leading-none tracking-[0.14em] text-ink shadow-e2"
  >
    <Icon name="whatsapp" class="h-4 w-4 text-primary" />
    Agendar visita
  </a>
</div>

<style>
  .sticky-visit {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    visibility: hidden;
    transition:
      opacity 360ms var(--ease-out-quint),
      transform 360ms var(--ease-out-quint),
      visibility 0s linear 360ms;
  }

  .sticky-visit[data-visible] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 360ms var(--ease-out-quint),
      transform 360ms var(--ease-out-quint),
      visibility 0s;
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  function initStickyVisit() {
    cleanup?.();

    const bar = document.querySelector<HTMLElement>("[data-sticky-visit]");
    const link = bar?.querySelector("a");
    const hero = document.querySelector("[data-chrome-sentinel]");
    const contact = document.getElementById("contacto");
    if (!bar || !link) return;

    // Se sigue cada condición por separado; la barra se ve cuando ya se dejó
    // atrás el hero y todavía no se llegó a la visita.
    let pastHero = !hero;
    let atContact = false; // la visita está en pantalla o ya quedó atrás

    const render = () => {
      const visible = pastHero && !atContact;
      bar.toggleAttribute("data-visible", visible);
      link.tabIndex = visible ? 0 : -1;
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) {
          pastHero =
            !entry.isIntersecting && entry.boundingClientRect.top < 0;
        } else {
          // También cuenta haberla pasado: en el pie ya no hace falta.
          atContact =
            entry.isIntersecting || entry.boundingClientRect.top < 0;
        }
      }
      render();
    });

    if (hero) observer.observe(hero);
    if (contact) observer.observe(contact);
    render();

    cleanup = () => {
      observer.disconnect();
      cleanup = null;
    };
  }

  document.addEventListener("astro:page-load", initStickyVisit);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
