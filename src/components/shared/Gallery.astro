---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { galleryId, getGalleryImages } from "@/lib/gallery";

/**
 * Galería masonry con visor a pantalla completa.
 *
 * Cada foto conserva su proporción real: las columnas se reparten el ancho y
 * la altura la dicta la imagen, así que nada se recorta en ningún dispositivo.
 * El orden del DOM es el del recorrido en el visor y el del teclado.
 *
 * Las imágenes se descubren en build desde `src/assets/<dir>/`: añadir una foto
 * a la carpeta la publica, sin tocar el .md ni este componente. El visor vive
 * en `@/scripts/lightbox`, compartido con los planos.
 */
interface Props {
  /** Ruta bajo `src/assets/`, p. ej. `images/gal/prueba`. */
  dir: string;
  /** Nombre legible de la residencia; alimenta los textos alternativos. */
  subject?: string;
  /** Corta la galería en las primeras N imágenes. */
  limit?: number;
  class?: string;
}

const { dir, subject = "", limit, class: className = "" } = Astro.props;

const all = getGalleryImages(dir);
const images = typeof limit === "number" ? all.slice(0, limit) : all;
const id = galleryId(dir);

/**
 * Dos columnas en cualquier pantalla; la tercera sólo aparece en escritorio y
 * sólo si hay fotos suficientes para llenarla sin dejar una columna huérfana.
 */
const WIDE_MIN_IMAGES = 5;
const isWide = images.length >= WIDE_MIN_IMAGES;
const sizes = isWide
  ? "(min-width: 1024px) 30vw, 46vw"
  : "(min-width: 1024px) 44vw, 46vw";
---

{
  images.length > 0 && (
    <div
      id={id}
      data-pswp-gallery
      class:list={[
        "not-prose columns-2 gap-x-3 sm:gap-x-4",
        isWide && "lg:columns-3",
        className,
      ]}
    >
      {images.map((src, i) => {
        const caption = subject
          ? `${subject} — imagen ${i + 1} de ${images.length}`
          : `Imagen ${i + 1} de ${images.length}`;

        return (
          <a
            href={src.src}
            data-pswp-width={src.width}
            data-pswp-height={src.height}
            data-pswp-caption={caption}
            target="_blank"
            rel="noreferrer"
            aria-label={`Ampliar: ${caption}`}
            class="press-soft group relative isolate mb-3 block break-inside-avoid overflow-hidden rounded-xl bg-panel-alt shadow-e1 focus-visible:outline-offset-4 sm:mb-4 sm:rounded-panel"
          >
            {/* `width`/`height` intrínsecos + `h-auto`: el navegador reserva
                el hueco exacto antes de cargar, sin saltos ni recortes. */}
            <Image
              src={src}
              alt={caption}
              widths={[400, 800, 1200]}
              sizes={sizes}
              loading={i < 2 ? "eager" : "lazy"}
              class="block h-auto w-full transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
            />

            {/* El velo y el icono sólo aparecen con la intención: en reposo
                manda la fotografía, no la interfaz. */}
            <span
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-base-black/55 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-2.5 right-2.5 grid h-9 w-9 translate-y-2 place-items-center rounded-full border border-white/25 bg-white/15 text-white opacity-0 backdrop-blur-md transition-[opacity,transform] duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 sm:bottom-3.5 sm:right-3.5"
              aria-hidden="true"
            >
              <Icon name="maximize" class="h-4 w-4" strokeWidth={1.9} />
            </span>
          </a>
        );
      })}
    </div>
  )
}

<script>
  import "@/scripts/lightbox";
</script>
