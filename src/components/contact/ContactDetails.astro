---
import type { IconType } from "react-icons";
import { LuMail, LuPhone, LuUserRound } from "react-icons/lu";
import { SOCIAL_ICONS } from "@/components/homeShared/socialIcons";
import type { ContactInfo } from "@/data/home";
import { SOCIAL_LINKS } from "@/data/site";
import { mailHref, phoneHref } from "@/lib/format";

/** Canales directos: cada fila es un enlace que hace lo que dice. */
interface Props {
  contact: ContactInfo;
}

const { contact } = Astro.props;

interface Row {
  label: string;
  value: string;
  href: string;
  Icon: IconType;
  external?: boolean;
}

const rows: Row[] = [
  {
    label: "Teléfono",
    value: contact.phone,
    href: phoneHref(contact.phone),
    Icon: LuPhone,
  },
  {
    label: "Correo",
    value: contact.email,
    href: mailHref(contact.email, "Quiero iniciar mi proyecto"),
    Icon: LuMail,
  },
  ...SOCIAL_LINKS.map(({ id, label, handle, href }) => ({
    label,
    value: handle,
    href,
    Icon: SOCIAL_ICONS[id],
    external: true,
  })),
];
---

<div class="flex flex-col gap-4">
  <div class="reveal person">
    <span class="row-icon" aria-hidden="true"><LuUserRound /></span>
    <div>
      <p class="row-label">Te atiende</p>
      <p class="mt-1 font-display text-2xl font-medium leading-tight text-ink">
        {contact.contactPerson}
      </p>
      <p class="mt-1 text-sm text-muted">Trato directo</p>
    </div>
  </div>

  <ul class="reveal rows" style="--reveal-delay: 80ms">
    {
      rows.map(({ label, value, href, Icon, external }) => (
        <li>
          <a
            href={href}
            class="row"
            {...(external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <span class="row-icon" aria-hidden="true">
              <Icon />
            </span>
            <span class="min-w-0">
              <span class="row-label block">{label}</span>
              <span class="mt-0.5 block truncate text-[0.9375rem] font-medium text-ink">
                {value}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .person,
  .rows {
    border-radius: 1.75rem;
    background: var(--glass-light-bg);
    border: 1px solid var(--glass-light-border);
    box-shadow:
      inset 0 1px 0 var(--glass-light-highlight),
      var(--glass-shadow);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur))
      saturate(var(--glass-saturate));
  }

  .person {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem;
  }

  .rows {
    padding: 0.375rem;
  }

  .row {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.15rem;
    border-radius: 1.4rem;
    transition:
      background-color 250ms ease-out,
      transform 400ms var(--ease-spring);
  }

  .row:hover {
    background-color: rgb(43 42 38 / 0.05);
  }

  .row:active {
    transform: scale(0.98);
    transition-duration: 100ms;
  }

  .row-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    font-size: 1.05rem;
    color: var(--color-darkGray);
    background: var(--color-primary);
  }

  .row-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-warmGray);
  }
</style>
