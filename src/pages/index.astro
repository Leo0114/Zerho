---
import Layout from "@/layouts/HomeLayout.astro";
import HeroSlider from "@/components/home/HeroSlider";
import Philosophy from "@/components/home/Philosophy.astro";
import Promises from "@/components/home/Promises.astro";
import Services from "@/components/home/Services.astro";
import Warranty from "@/components/home/Warranty.astro";
import Trayectoria from "@/components/home/Trayectoria.astro";
import Team from "@/components/home/Team.astro";
import ContactCta from "@/components/home/ContactCta.astro";
import { homeData } from "@/data/home";
import { CONTACT_PATH } from "@/lib/navigation";

export const prerender = true;

const { hero, commercialPhrases, services, warrantyAndValue, contact } =
  homeData;
---

<Layout>
  <HeroSlider client:load hero={hero} contactPath={CONTACT_PATH} />
  <Philosophy statement={hero.valueProposition} />
  <Promises phrases={commercialPhrases} />
  <Services services={services} />
  <Warranty warranty={warrantyAndValue} />
  <Trayectoria />
  <Team />
  <ContactCta contact={contact} />
</Layout>
